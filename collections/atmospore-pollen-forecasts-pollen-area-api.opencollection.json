{
  "opencollection": "1.0.0",
  "info": {
    "name": "Atmospore Pollen Forecast Pollen Area API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pollen Area",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Area pollen averages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pollenapi.com/v1/pollen-area",
            "params": [
              {
                "name": "lon",
                "value": "",
                "type": "query",
                "description": "Longitude coordinate"
              },
              {
                "name": "lat",
                "value": "",
                "type": "query",
                "description": "Latitude coordinate"
              },
              {
                "name": "dt",
                "value": "",
                "type": "query",
                "description": "Start date (YYYY-MM-DD)"
              },
              {
                "name": "forecast_days",
                "value": "",
                "type": "query",
                "description": "Number of forecast days"
              },
              {
                "name": "species",
                "value": "",
                "type": "query",
                "description": "Comma-separated species or groups (tree, grass, weed, all). Defaults to all."
              },
              {
                "name": "radius",
                "value": "",
                "type": "query",
                "description": "Search radius in meters"
              }
            ]
          },
          "docs": "Average, minimum, and maximum pollen levels across a configurable radius. Ideal for regional dashboards and area-wide risk assessment."
        }
      ]
    }
  ],
  "bundled": true
}