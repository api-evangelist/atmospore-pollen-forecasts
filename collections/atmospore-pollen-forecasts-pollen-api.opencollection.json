{
  "opencollection": "1.0.0",
  "info": {
    "name": "Atmospore Forecast Pollen API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pollen",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Pollen forecast at a point",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pollenapi.com/v1/pollen",
            "params": [
              {
                "name": "lon",
                "value": "",
                "type": "query",
                "description": "Longitude coordinate"
              },
              {
                "name": "lat",
                "value": "",
                "type": "query",
                "description": "Latitude coordinate"
              },
              {
                "name": "dt",
                "value": "",
                "type": "query",
                "description": "Start date (YYYY-MM-DD)"
              },
              {
                "name": "forecast_days",
                "value": "",
                "type": "query",
                "description": "Number of forecast days"
              },
              {
                "name": "species",
                "value": "",
                "type": "query",
                "description": "Comma-separated species or groups (tree, grass, weed, all). Defaults to all."
              }
            ]
          },
          "docs": "Interpolated pollen forecast at a specific coordinate. Returns species-level data with risk levels and an overall daily risk score."
        }
      ]
    }
  ],
  "bundled": true
}